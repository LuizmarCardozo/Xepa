rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Cada usuário autenticado acessa o próprio documento de perfil.
    match /users/{userId} {
      allow create, read, update: if request.auth != null
        && request.auth.uid == userId;
    }

    // Define quem pode ler e atualizar os dados públicos de uma banca.
    match /markets/{marketId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.auth.uid == marketId
        && get(/databases/$(database)/documents/users/$(marketId))
          .data.type == 'comerciante'
        && request.resource.data.keys().hasOnly([
          'stallName', 'marketName', 'city', 'state', 'reference', 'image',
          'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'stallName', 'city', 'state', 'image', 'updatedAt'
        ])
        && request.resource.data.stallName is string
        && request.resource.data.stallName.size() > 0
        && request.resource.data.stallName.size() <= 100
        && request.resource.data.city is string
        && request.resource.data.city.size() <= 100
        && request.resource.data.state is string
        && request.resource.data.state.size() <= 100
        && (!request.resource.data.keys().hasAny(['marketName'])
          || (request.resource.data.marketName is string
            && request.resource.data.marketName.size() <= 100))
        && (!request.resource.data.keys().hasAny(['reference'])
          || (request.resource.data.reference is string
            && request.resource.data.reference.size() <= 200))
        && request.resource.data.image is string
        && request.resource.data.image.size() <= 2048
        && (request.resource.data.image == ''
          || request.resource.data.image.matches('https://.*'))
        && request.resource.data.updatedAt is string
        && request.resource.data.updatedAt.size() <= 40;
      allow delete: if false;
    }

    // A leitura considera ofertas ativas; alterações verificam o proprietário.
    match /offers/{offerId} {
      allow read: if request.auth != null
        && (resource.data.active == true
          || resource.data.ownerUid == request.auth.uid);
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if request.auth != null
        && resource.data.ownerUid == request.auth.uid;
    }

    // Novidades podem ser lidas por usuários autenticados e alteradas pelo dono.
    match /stories/{storyId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if request.auth != null
        && resource.data.ownerUid == request.auth.uid;
    }

    // Define acesso aos pedidos por comprador e vendedor e os critérios de avaliação.
    match /orders/{orderId} {
      allow create: if request.auth != null
        && request.resource.data.buyerUid == request.auth.uid;
      allow read: if request.auth != null
        && (resource.data.buyerUid == request.auth.uid
          || resource.data.merchantUid == request.auth.uid);
      allow update: if request.auth != null
        && (resource.data.merchantUid == request.auth.uid
          || (resource.data.buyerUid == request.auth.uid
            && request.resource.data.status == 'cancelled')
          || (resource.data.buyerUid == request.auth.uid
            && resource.data.status in ['completed', 'delivered']
            && !resource.data.keys().hasAny(['review'])
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['review'])
            && request.resource.data.review is map
            && request.resource.data.review.keys()
              .hasAll(['rating', 'comment', 'createdAt'])
            && request.resource.data.review.keys()
              .hasOnly(['rating', 'comment', 'createdAt'])
            && request.resource.data.review.rating is int
            && request.resource.data.review.rating >= 1
            && request.resource.data.review.rating <= 5
            && request.resource.data.review.comment is string
            && request.resource.data.review.comment.size() <= 500
            && request.resource.data.review.createdAt is string));
      allow delete: if false;
    }
  }
}
